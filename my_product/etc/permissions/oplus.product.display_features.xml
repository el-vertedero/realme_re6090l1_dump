<oplus-config>
    <!-- =================== DISPLAY FEATURES BEGIN ================================ -->
    <!-- heteromorphism feature -->
    <oplus-feature name="oplus.software.display.screen_heteromorphism" />

    <!-- brightness default common feature -->
    <oplus-feature name="oplus.software.display.screen_gloablehbm_support" />
    <oplus-feature name="oplus.software.display.autobrightctl_animation_support" />
    <oplus-feature name="oplus.software.display.multibits_dimming_support" />
    <oplus-feature name="oplus.software.display.brightness_mode_automatic" />

    <!-- colormode feature 1.0/2.0-->
    <oplus-feature name="oplus.software.display.cinema_mode_support" />
    <oplus-feature name="oplus.software.display.colorful_mode_support" />
    <oplus-feature name="oplus.software.display.colormode_calibrate_support" />
    <oplus-feature name="oplus.software.display.colormode_support" />

    <!-- aod feature -->
    <oplus-feature name="oplus.software.display.aod_support" />
    <oplus-feature name="oplus.software.display.aod_prevent_burn_support" />
    <oplus-feature name="oplus.software.display.video_mode_aod_support"/>
	<oplus-feature name="oplus.software.disable_aod_all_day_mode" />

    <!-- sceen fingerprint feature -->
    <oplus-feature name="oplus.software.fingeprint_optical_enabled"/>

    <!-- Add for dual light sensor support-->
    <oplus-feature name="oplus.software.display.dual_lightsensor_support"/>
    <oplus-feature name="oplus.software.display.enhance_brightness_with_uidimming" />
    <oplus-feature name="oplus.software.display.rgb_ball_support" />

    <!-- #ifdef OPLUS_FEATURE_EYE_PROTECT -->
    <oplus-feature name="oplus.software.display.intelligent_color_temperature_support" />
    <oplus-feature name="oplus.software.display.lock_color_temperature_in_drag_brightness_bar_support"/>
    <oplus-feature name="oplus.software.display.smart_color_temperature_rhythm_health_support"/>
    <!-- #endif /* OPLUS_FEATURE_EYE_PROTECT */ -->


    <!-- Liurongbo@MULTIMEDIA.DISPLAY.SF, 2023/5/10, Add for resoultionsiwtch feature start -->
    <oplus-feature name="oplus.software.display.resolution_switch_support" />
    <oplus-feature name="oplus.software.display.resolution_switch_disableauto_support" />
    <!-- Add for resolutionswitch feature end -->

    <!-- luozeng@MULTIMEDIA.DISPLAY.SF, 2024/05/09, Add for sharpness feature -->
    <oplus-feature name="oplus.software.display.sharpness_switch"/>
    <!-- Add for resolutionswitch feature end -->

    <!-- Add for display calbrication 100APL   -->
    <oplus-feature name="oplus.software.display.screen_calibrate_100apl"/>

    <!-- sceen mode feature -->
    <oplus-feature name="oplus.software.display.dynamic_fps_switch" />
    <oplus-feature name="oplus.software.display.refreshrate_default_smart"/>
    <oplus-feature name="oplus.software.display.multi_device_decrease_refresh_rate" />

    <!-- Add for camera brighten -->
    <oplus-feature name="oplus.software.display.camera.brighten"/>
    <!-- Add for peak brightness test -->
    <oplus-feature name="oplus.software.display.peak_brightness_test_support"/>

    <!-- Add for eyeprotect single pulse rm support-->
    <!--<oplus-feature name="oplus.software.display.eyeprotect_single_pulse_rm_support" />-->

    <!--<oplus-feature name="oplus.software.display.single_pulse_refreshrate_144_not_support"/>-->
    <oplus-feature name="oplus.software.display.adfr_v32_lp"/>

    <!-- Add for Apply brightness reduction-->
    <oplus-feature name="oplus.software.display.reduce_brightness_rm"/>
    <oplus-feature name="oplus.software.display.reduce_brightness_rm_manual"/>


    <!-- Add for reduce white point -->
    <oplus-feature name="oplus.software.display.reduce_white_point"/>

    <!-- Add for motion sickness UI -->
    <oplus-feature name="oplus.hardware.display.motion_sickness"/>
    <!-- =================== DISPLAY FEATURES END ================================== -->
</oplus-config>
