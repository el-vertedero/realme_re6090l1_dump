	fragment@73 {
		target = <0xffffffff>;

		__overlay__ {
			racing-enable;
		};
	};

	fragment@74 {
		target = <0xffffffff>;

		__overlay__ {

			oplus_devinfo {
				compatible = "oplus-devinfo";
				pinctrl-names = "default", "aboard_gpio0_sleep", "aboard_gpio0_active", "aboard_gpio0_idle";
				pinctrl-0 = <0x46>;
				pinctrl-1 = <0x47>;
				pinctrl-2 = <0x48>;
				pinctrl-3 = <0x49>;
				phandle = <0xd8>;

				main-sub {
					use_tristate_gpio;
					compatible = "hw-match, main-sub";
					aboard-gpio0 = <0xffffffff 0x81 0x00>;
					aboard-patterns = <0x01 0x00 0x01 0x00 0x01 0x00 0x01 0x00 0x01 0x00>;
					rf_match_support;
					rf-patterns = <0x28 0x29 0x2b 0x2c 0x31 0x32 0x34 0x35 0x43 0x44>;
					match-projects = <0x629a 0x629a 0x629a 0x629a 0x629a 0x629a 0x629a 0x629a 0x629a 0x629a>;
				};
			};
		};
	};

	fragment@75 {
		target = <0xffffffff>;

		__overlay__ {

			default@hw_sub_id {
				phandle = <0x46>;
			};

			sleep@id0 {
				phandle = <0x47>;

				pins_cmd_dat {
					pinmux = <0x8100>;
					slew-rate = <0x00>;
					bias-pull-down;
					input-enable;
				};
			};

			active@id0 {
				phandle = <0x48>;

				pins_cmd_dat {
					pinmux = <0x8100>;
					slew-rate = <0x00>;
					bias-pull-up;
					input-enable;
				};
			};

			idle@id0 {
				phandle = <0x49>;

				pins_cmd_dat {
					pinmux = <0x8100>;
					slew-rate = <0x00>;
					bias-disable;
					input-enable;
				};
			};
		};
	};

	fragment@76 {
		target = <0xffffffff>;

		__overlay__ {
			keypad,volume-down = <0xffffffff 0x1f 0x00>;
			pinctrl-names = "volume_down_as_int";
			pinctrl-0 = <0x4a>;
			status = "okay";
		};
	};

	fragment@77 {
		target = <0xffffffff>;

		__overlay__ {

			volume_down@0 {
				phandle = <0x4a>;

				pins_cmd_dat {
					pinmux = <0x1f00>;
					slew-rate = <0x00>;
					input-enable;
					bias-disable;
				};
			};
		};
	};

	fragment@78 {
		target = <0xffffffff>;

		__overlay__ {

			kpd_volume_down {
				compatible = "mediatek, VOLUME_DOWN-eint";
				interrupt-parent = <0xffffffff>;
				interrupts = <0x1f 0x02 0x1f 0x00>;
				debounce = <0x7d00>;
				status = "okay";
				phandle = <0xd9>;
			};
		};
	};

	fragment@79 {
		target = <0xffffffff>;

		__overlay__ {

			state_default_a {
				phandle = <0x4b>;

				pins_cmd_dat {
					pinmux = <0x4f00>;
				};
			};

			state_reset_high_a {
				phandle = <0x4c>;

				pins_cmd_dat {
					pinmux = <0x4f00>;
					slew-rate = <0x01>;
					output-high;
				};
			};

			i2c_state {
				phandle = <0x4d>;

				pins_cmd_dat {
					pinmux = <0x8901 0x8a01>;
					bias-pull-up;
				};
			};
		};
	};

