			oc-limit-freq-lv1 = <0x124f80>;
			oc-limit-freq-lv2 = <0xaae60>;
			soc-max-level = <0x01>;
			soc-limit-freq-lv1 = <0x7fffffff>;
		};
	};

	fragment@65 {
		target = <0xffffffff>;

		__overlay__ {

			oplus_project {
				compatible = "oplus,oplus_project";
				phandle = <0xcb>;
			};

			oplus_boardid {
				compatible = "oplus,oplus_boardid-v2";
				support-dtsino = <0x5f05>;
				support-pcbmask = <0xffffffff 0xffffffff 0xffffffff>;
				phandle = <0xcc>;
			};

			pmic_history_count {
				phandle = <0xcd>;
			};

