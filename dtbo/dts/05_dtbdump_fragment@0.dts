		__overlay__ {
			compatible = "mediatek,gpu-power-throttling";
			lbat-max-level = <0x03>;
			lbat-limit-freq-lv1 = <0x7fffffff>;
			lbat-limit-freq-lv2 = <0x124f80>;
			lbat-limit-freq-lv3 = <0xaae60>;
