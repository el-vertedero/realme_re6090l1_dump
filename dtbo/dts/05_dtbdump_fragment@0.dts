/dts-v1/;

/ {

	fragment@0 {
		target = <0xffffffff>;

		__overlay__ {
			trustonic,real-drv = <0x01>;
			trustonic,sel2-support = <0x00>;
		};
	};

	fragment@1 {
		target = <0xffffffff>;

		__overlay__ {
			bootargs_ext = [00];
		};
	};

	fragment@2 {
		target = <0xffffffff>;

		__overlay__ {

			speaker_amp@5c {
				compatible = "richtek,rt5512";
				#sound-dai-cells = <0x00>;
				reg = <0x5c>;
				status = "okay";
				sound-name-prefix = "Left";
				phandle = <0x01>;
			};
		};
	};

	fragment@3 {
		target = <0xffffffff>;

		__overlay__ {
			mediatek,spk-i2s = <0x15 0x14>;

			mediatek,speaker-codec {
				sound-dai = <0x01>;
			};
		};
	};

	fragment@4 {
		target = <0xffffffff>;

		__overlay__ {

			ps-enable {
				phandle = <0x04>;

				pins-cmd-dat {
					pinmux = <0x4100>;
					output-high;
				};
			};

			ps-disable {
				phandle = <0x05>;

				pins-cmd-dat {
					pinmux = <0x4100>;
					output-low;
				};
			};
		};
	};

	fragment@5 {
		target = <0xffffffff>;

		__overlay__ {

			port {

				endpoint {
					remote-endpoint = <0x02>;
					phandle = <0x03>;
				};
			};
		};
	};

	fragment@6 {
		target = <0xffffffff>;

		__overlay__ {
			orientation-switch;
			mode-switch;
			accessory;

			port {

				endpoint {
					remote-endpoint = <0x03>;
					phandle = <0x02>;
				};
			};
		};
	};

	fragment@7 {
		target = <0xffffffff>;

		__overlay__ {
			pinctrl-names = "enable", "disable";
			pinctrl-0 = <0x04>;
			pinctrl-1 = <0x05>;
			status = "okay";
		};
	};

	fragment@8 {
		target = <0xffffffff>;

		__overlay__ {
			status = "okay";
		};
	};

	fragment@9 {
		target = <0xffffffff>;

		__overlay__ {

			lcd-bias-enp1-gpio {
				phandle = <0x06>;

				pins-cmd-dat {
					pinmux = <0x8300>;
					slew-rate = <0x01>;
					output-high;
				};
			};

			lcd-bias-enp0-gpio {
				phandle = <0x07>;

				pins-cmd-dat {
					pinmux = <0x8300>;
					slew-rate = <0x01>;
					output-low;
				};
			};

			lcd-bias-enn1-gpio {
				phandle = <0x08>;

				pins-cmd-dat {
					pinmux = <0x8300>;
					slew-rate = <0x01>;
					output-high;
				};
			};

			lcd-bias-enn0-gpio {
				phandle = <0x09>;

				pins-cmd-dat {
					pinmux = <0x8300>;
					slew-rate = <0x01>;
					output-low;
				};
			};

			lcm-rst-out1-gpio {
				phandle = <0x0a>;

				pins-cmd-dat {
					pinmux = <0x2800>;
					slew-rate = <0x01>;
					output-high;
				};
			};

			lcm-rst-out0-gpio {
				phandle = <0x0b>;

				pins-cmd-dat {
					pinmux = <0x2900>;
					slew-rate = <0x01>;
					output-low;
				};
			};

			lcm-dsi-te {
				phandle = <0x0c>;

				pins-cmd-dat {
					pinmux = <0x2b01>;
				};
			};

			lcm-led-en1-gpio {
				phandle = <0x0d>;

				pins-cmd-dat {
					pinmux = <0x4000>;
					slew-rate = <0x01>;
					output-high;
				};
			};

			lcm-led-en0-gpio {
				phandle = <0x0e>;

				pins-cmd-dat {
					pinmux = <0x4000>;
					slew-rate = <0x01>;
					output-low;
				};
			};

			lcm-dsi1-te {
				phandle = <0x0f>;

				pins-cmd-dat {
					pinmux = <0x2a01>;
				};
			};

			lcm-dsi-gpio {
				phandle = <0x9d>;

				pins-cmd-dat {
					pinmux = <0x2b00>;
				};
			};

			lcm-dsi1-gpio {
				phandle = <0x9e>;

				pins-cmd-dat {
					pinmux = <0x2a00>;
				};
			};
		};
	};

	fragment@10 {
		target = <0xffffffff>;

		__overlay__ {
			pinctrl-names = "lcd_bias_enp1_gpio", "lcd_bias_enp0_gpio", "lcd_bias_enn1_gpio", "lcd_bias_enn0_gpio", "lcm_rst_out1_gpio", "lcm_rst_out0_gpio", "mode_te_te", "lcm_led_en1_gpio", "lcm_led_en0_gpio", "mode_te_te1";
			pinctrl-0 = <0x06>;
			pinctrl-1 = <0x07>;
			pinctrl-2 = <0x08>;
			pinctrl-3 = <0x09>;
			pinctrl-4 = <0x0a>;
			pinctrl-5 = <0x0b>;
			pinctrl-6 = <0x0c>;
			pinctrl-7 = <0x0d>;
			pinctrl-8 = <0x0e>;
			pinctrl-9 = <0x0f>;
			status = "okay";
		};
	};

	fragment@11 {
		target = <0xffffffff>;

		__overlay__ {
			pinctrl-names = "mode_te_te", "mode_te_te1";
			pinctrl-0 = <0x0c>;
			pinctrl-1 = <0x0f>;
			status = "okay";
			bypass-pc-path = <0x01>;
			relay-aal-hw = <0x01>;
		};
	};

	fragment@12 {
		target = <0xffffffff>;

		__overlay__ {
			status = "okay";
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			panel1@0 {
				compatible = "jdi,nt36672e,vdo,120hz,threshold";
				reg = <0x00>;
				pm-enable-gpios = <0xffffffff 0x40 0x00>;
				reset-gpios = <0xffffffff 0x29 0x00>;
				res-switch = <0x02>;
				gate-ic = <0x12df>;
				pinctrl-names = "default";

				port {

					endpoint {
						remote-endpoint = <0x10>;
						phandle = <0x11>;
					};
				};
			};

			ports {

				port {

					endpoint@0 {
						remote-endpoint = <0x11>;
						phandle = <0x10>;
					};
				};
			};
		};
	};

	fragment@13 {
		target = <0xffffffff>;

		__overlay__ {
		};
	};

	fragment@14 {
		target = <0xffffffff>;

		__overlay__ {
			pinctrl-names = "kpcol0_mode";
			pinctrl-0 = <0x12>;

			home2 {
				linux,keycodes = <0x72>;
				wakeup-source;
			};
		};
	};

	fragment@15 {
		target = <0xffffffff>;

		__overlay__ {

			gpio-mode {
				phandle = <0x12>;

				pins-cmd-dat {
					pinmux = <0x2000>;
					input-enable;
				};
			};
		};
	};

	fragment@16 {
		target = <0xffffffff>;

		__overlay__ {

			epa-elna-mtk {
				parts = <0xffffffff 0xffffffff 0xffffffff 0xffffffff 0xffffffff 0xffffffff 0xffffffff 0xffffffff 0xffffffff 0xffffffff>;

				wifi {

					flags-1 {
					};

					flags-2 {
					};

					flags-3 {
					};

					flags-4 {
					};
				};

				bt {

					flags-1 {
						epa-elna;
					};

					flags-2 {
						epa-elna;
					};

					flags-3 {
						epa-elna;
					};

					flags-4 {
						epa-elna;
					};
				};
			};
		};
	};

