				phandle = <0xcf>;
			};

			pmic_history2 {
				phandle = <0xd0>;
			};

			pmic_history3 {
				phandle = <0xd1>;
			};
		};
	};

	fragment@66 {
		target = <0xffffffff>;

		__overlay__ {

			oplus_sim_detect {
				compatible = "oplus, sim_detect";
				Hw,sim_det = <0xffffffff 0x3a 0x00>;
			};
		};
	};

	fragment@67 {
		target = <0xffffffff>;

		__overlay__ {

			oplus-gpio {
				compatible = "oplus,oplus-gpio";
				pinctrl-names = "default", "sim2_det_no_pull", "sim2_det_pull_high", "sim2_det_pull_low";
				pinctrl-0 = <0x48 0x49 0x4a>;
				pinctrl-1 = <0x4a>;
				pinctrl-2 = <0x4b>;
				pinctrl-3 = <0x4c>;
				oplus,oplus-esim-en = <0xffffffff 0x2f 0x00>;
				oplus,oplus-nfc-gpio0 = <0xffffffff 0x06 0x00>;
				oplus,oplus-sim2-det = <0xffffffff 0x4c 0x00>;
			};
		};
	};

	fragment@68 {
		target = <0xffffffff>;

		__overlay__ {

			esim_det_en {
				phandle = <0x48>;

				pins_cmd_dat {
					pinmux = <0x2f00>;
					slew-rate = <0x01>;
					bias-disable;
					drive-strength = <0x02>;
					output-high;
				};
			};

			nfc_gpio0 {
				phandle = <0x49>;

				pins_cmd_dat {
					pinmux = <0x600>;
					slew-rate = <0x01>;
					bias-disable;
					drive-strength = <0x02>;
					output-high;
				};
			};

			sim2_det_no_pull {
				phandle = <0x4a>;

				pins_cmd_dat {
					pinmux = <0x4c00>;
					slew-rate = <0x00>;
					bias-disable;
					input-enable;
				};
			};

			sim2_det_pull_high {
				phandle = <0x4b>;

				pins_cmd_dat {
					pinmux = <0x4c00>;
					slew-rate = <0x00>;
					bias-pull-up;
					input-enable;
				};
			};

			sim2_det_pull_low {
				phandle = <0x4c>;

				pins_cmd_dat {
					pinmux = <0x4c00>;
					slew-rate = <0x00>;
					bias-pull-down;
					input-enable;
				};
			};
		};
	};

	fragment@69 {
		target = <0xffffffff>;

