/dts-v1/;

/ {

	fragment@0 {
		target = <0xffffffff>;

		__overlay__ {
			trustonic,real-drv = <0x01>;
			trustonic,sel2-support = <0x00>;
		};
	};

	fragment@1 {
		target = <0xffffffff>;

		__overlay__ {
			bootargs_ext = [00];
		};
	};

	fragment@2 {
		target = <0xffffffff>;

		__overlay__ {

			speaker_amp@5c {
				compatible = "richtek,rt5512";
				#sound-dai-cells = <0x00>;
				reg = <0x5c>;
				status = "okay";
				sound-name-prefix = "Left";
				phandle = <0x01>;
			};
		};
	};

	fragment@3 {
		target = <0xffffffff>;

		__overlay__ {
			mediatek,spk-i2s = <0x15 0x14>;

			mediatek,speaker-codec {
				sound-dai = <0x01>;
			};
		};
	};

	fragment@4 {
		target = <0xffffffff>;

		__overlay__ {

			ps-enable {
				phandle = <0x04>;

				pins-cmd-dat {
					pinmux = <0x4100>;
					output-high;
				};
			};

			ps-disable {
				phandle = <0x05>;

				pins-cmd-dat {
					pinmux = <0x4100>;
					output-low;
				};
			};
		};
	};

	fragment@5 {
		target = <0xffffffff>;

		__overlay__ {

			port {

				endpoint {
					remote-endpoint = <0x02>;
					phandle = <0x03>;
				};
			};
		};
	};

	fragment@6 {
		target = <0xffffffff>;

		__overlay__ {
			orientation-switch;
			mode-switch;
			accessory;

			port {

				endpoint {
					remote-endpoint = <0x03>;
					phandle = <0x02>;
				};
			};
		};
	};

	fragment@7 {
		target = <0xffffffff>;

		__overlay__ {
			pinctrl-names = "enable", "disable";
			pinctrl-0 = <0x04>;
			pinctrl-1 = <0x05>;
			status = "okay";
		};
	};

	fragment@8 {
		target = <0xffffffff>;

		__overlay__ {
			status = "okay";
		};
	};

	fragment@9 {
		target = <0xffffffff>;

