				sound-dai = <0x01>;
			};
		};
	};

	fragment@4 {
		target = <0xffffffff>;

		__overlay__ {

			ps-enable {
				phandle = <0x04>;

				pins-cmd-dat {
					pinmux = <0x4100>;
					output-high;
				};
			};

			ps-disable {
				phandle = <0x05>;

				pins-cmd-dat {
					pinmux = <0x4100>;
					output-low;
				};
			};
