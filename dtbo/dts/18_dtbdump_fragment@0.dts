/dts-v1/;

/ {

	fragment@0 {
		target = <0xffffffff>;

		__overlay__ {
			trustonic,real-drv = <0x01>;
			trustonic,sel2-support = <0x00>;
		};
	};

	fragment@1 {
		target = <0xffffffff>;

		__overlay__ {
