<?xml version="1.0" encoding="utf-8" ?>
<Included>
    <Decoders>
         <MediaCodec name="c2.dolby.decoder.hevc" type="video/dolby-vision">
            <Limit name="size" min="64x64" max="4096x2176"/>
            <Limit name="alignment" value="2x2"/>
            <Limit name="block-size" value="16x16"/>
            <Limit name="block-count" range="1-138240"/>
            <Limit name="blocks-per-second" min="1" max="8294400"/>
            <Limit name="bitrate" range="1-240000000"/>
            <Limit name="frame-rate" range="1-240"/>
            <Feature name="adaptive-playback"/>
            <Feature name="can-swap-width-height"/>
            <Feature name="dynamic-color-aspects"/>
            <!--WangZhikun@MULTIMEDIA.MEDIASERVER.PLAYER 8732247 Add Dolby Codec Feature-->
            <Feature name="oplus-dolby-vision-color-mode" />
            <Limit name="concurrent-instances" max="15"/>
            <Limit name="performance-point-3840x2160" value="120" />
            <Limit name="performance-point-1920x1079" value="180" />
        </MediaCodec>
        <MediaCodec name="c2.dolby.decoder.hevc.secure" type="video/dolby-vision">
            <Limit name="size" min="16x16" max="3840x2160" />
            <Limit name="block-count" range="1-32400" />
            <Limit name="alignment" value="2x2" />
            <Limit name="block-size" value="16x16" />
            <Limit name="blocks-per-second" min="1" max="1944000" />
            <Limit name="bitrate" range="1-40000000" />
            <Limit name="frame-rate" range="1-60" />
            <Limit name="concurrent-instances" max="1" />
            <Limit name="performance-point-4096x2304" value="30" />
            <Limit name="performance-point-4096x2160" value="60" />
            <Limit name="performance-point-3840x2160" value="60" />
            <Feature name="adaptive-playback" />
            <Feature name="secure-playback" required="true" />
        </MediaCodec>
    </Decoders>
</Included>