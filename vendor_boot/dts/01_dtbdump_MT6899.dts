		tz-system {
			compatible = "mediatek,trusty-tz";
			virtio-supply = <0x126>;
			irq-supply = <0x1c3>;
			phandle = <0x1c4>;
		};

		mtee {
			compatible = "mediatek,trusty-mtee-v1";
			tz-supply = <0x1c4>;
			phandle = <0x127>;
		};

		trusty-gz-log {
			compatible = "android,trusty-gz-log-v1";
		};

		trusty-sapu {
			compatible = "mediatek,trusty-sapu";
			#address-cells = <0x02>;
			#size-cells = <0x02>;
			power-version = <0x01>;
			datamem-type = <0x02>;
			datamem-size = <0x00 0x00>;
			iommus = <0x107 0x120541>;
			status = "okay";
		};
	};

	nebula {
		compatible = "android,nebula-smc-v1";
		ranges;
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		tee-id = <0x01>;
		tee-name = "nebula";
		phandle = <0x3a7>;

		nebula-virtio {
			compatible = "android,nebula-virtio-v1";
		};

		nebula-irq {
			compatible = "android,nebula-irq-v1";
			ppi-interrupt-parent = <0x01>;
		};

		nebula-gz-log {
			compatible = "android,nebula-gz-log-v1";
		};
	};

	hypervisor {
		compatible = "mediatek,geniezone-hyp", "mediatek,geniezone";
		status = "okay";
		phandle = <0x3a8>;
	};

